# Variables de entorno requeridas para Questlog
# Copiar este archivo a .env.local y rellenar los valores

# ── Base de datos (Supabase / Postgres) ──────────────────────────────────────
DATABASE_URL=

# ── Better Auth ───────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens y cookies de sesión.
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL base de la aplicación (usada por Better Auth para construir URLs de callback).
BETTER_AUTH_URL=

# ── Vite (expuesto al cliente con prefijo VITE_) ──────────────────────────────
# Fallback SSR para el cliente de Better Auth (el navegador usa window.location.origin).
# Solo es necesario si se hacen llamadas a authClient desde código de servidor.
VITE_APP_URL=

